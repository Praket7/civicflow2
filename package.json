{
  "name": "civicflow",
  "private": true,
  "license": "MIT",
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "check:copy": "node scripts/check-copy.mjs",
    "test": "vitest run",
    "test:sql": "node --test supabase/tests/*.test.mjs",
    "test:watch": "vitest",
    "build:web": "tsc && vite build",
    "db:verify": "node scripts/verify-database.mjs",
    "audit:contrast": "node scripts/audit-contrast.mjs",
    "audit:print": "node scripts/audit-print.mjs",
    "audit:zoom": "node scripts/audit-zoom.mjs",
    "audit:a11y": "node scripts/audit-accessibility-tree.mjs",
    "test:native": "wdio run wdio.conf.mjs",
    "build:native:test": "node scripts/build-native-test.mjs",
    "verify": "bash scripts/verify.sh",
    "verify:docs": "pnpm docs:update && pnpm docs:check",
    "check:i18n": "node scripts/i18n-extract.mjs && git diff --exit-code -- src/lib/i18n/strings.json",
    "check:generated": "node scripts/generate-demo-data.mjs && node scripts/i18n-extract.mjs && git diff --exit-code -- shared/demo-workspace.json src/lib/i18n/strings.json",
    "check:hardcodes": "node scripts/check-runtime-hardcodes.mjs",
    "check:identity": "node scripts/check-identity.mjs",
    "check:help": "node scripts/check-help-coverage.mjs",
    "third-party:update": "node scripts/generate-third-party.mjs",
    "check:third-party": "node scripts/generate-third-party.mjs --check",
    "docs:update": "node scripts/update-readme-facts.mjs",
    "docs:check": "node scripts/check-docs.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.104.5",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-deep-link": "^2.6.2",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "@zxing/browser": "^0.2.1",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.7",
    "lucide-react": "^1.61.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@babel/core": "^8.0.9",
    "@babel/parser": "^8.0.8",
    "@babel/traverse": "^8.0.7",
    "@electric-sql/pglite": "^0.5.13",
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jest-axe": "^3.5.9",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@wdio/cli": "^9.32.0",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.31.2",
    "@wdio/tauri-service": "^1.5.1",
    "eslint": "^10.13.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "webdriverio": "^9.32.0"
  }
}
